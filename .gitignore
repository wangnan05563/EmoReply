# ============================================================
# EmoReply — 忽略规则
# 规则依据 2026-10-13 全空间实测扫描；只列本项目真实存在/可再生成的类别
# ============================================================

# ---------- 构建产物 ----------
# Android/Gradle：工程内缓存与兜底输出目录
android-app/.gradle/
android-app/app/build/
android-app/build/
# 一次性产物根目录：桌面/Android 产物、构建缓存与 Node 工具链均在此。
# 整目录删除后可经 scripts/ 下的构建脚本从零重建，不影响源码与外部 SDK/JDK；
# 只想清产物（保留缓存/工具链）用 scripts/clean-release.ps1。
# Android: app/build.gradle.kts 的 layout.buildDirectory = ../release/build/app
# 桌面: desktop-app/package.json 的 build.directories.output = ../release/desktop-installer
release/
# APK/AAB 与中间签名物
*.apk
*.aab

# Desktop（Electron + electron-builder）
desktop-app/node_modules/
desktop-app/dist/
desktop-app/tmp/

# Python POC（m1-core）
__pycache__/
*.py[cod]
.venv/
venv/

# iOS（预防：Xcode 衍生数据；当前源码树尚无这些目录）
ios-app/**/build/
xcuserdata/
DerivedData/
Pods/

# ---------- 本机配置（机器相关，不入库） ----------
local.properties
# 一键发布的机器级覆盖（JDK / Gradle / 解释器路径），叠加在 scripts/config.json 之上
scripts/config.local.json
*.properties.bak
*.jks
*.keystore
*.p12
*.pem

# ---------- 敏感信息 ----------
# 含明文 API key 的品牌工具配置（2026-10-13 核实）
brand/_source/agnes-config.yaml
.env
.env.*
*credentials*

# ---------- 日志 / 临时 / 清理残留 ----------
*.log
tmp/
cleanup-logs/
.cleanup-quarantine/

# ---------- IDE / Agent 工作区 ----------
.idea/
.vscode/
*.iml
.qoder-cn/
.workbuddy/

# ---------- 系统生成 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 补充（2026-10-18 git 初始化时补扫） ----------
/.build/
.pytest_cache/
